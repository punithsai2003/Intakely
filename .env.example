# Set these as environment variables (or in your host's secret settings). Never commit real keys.
GEMINI_API_KEY=               # free key from Google AI Studio
GROQ_API_KEY=                 # free key from Groq console
LLM_PROVIDERS=gemini,groq     # order to try; the next one is used if the first fails
INTAKELY_SECRET=              # long random string; signs doctor sessions: python -c "import secrets;print(secrets.token_hex(32))"
INTAKELY_USE_LLM=1            # set 0 to force rules-only
INTAKELY_DEMO_SEED=1          # demo doctors and sample patients (synthetic). Keep 1 for the showcase
INTAKELY_DB=./intakely.db
